{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "docker-compose",
    "kubernetes",
    "pip-compile",
    "pip_requirements",
    "terraform"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**"
  ],
  "packageRules": [
    {
      "description": "Regenerate compiled locks with their recorded source command; avoid independent edits to inputs or output snapshots.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".github/requirements-ci.in",
        ".github/requirements-ci.txt"
      ],
      "enabled": false
    },
    {
      "description": [
        "Only the coupled cloudflared runtime image is managed in the Kubernetes example; keep API versions and other dependencies unchanged."
      ],
      "matchManagers": [
        "kubernetes"
      ],
      "enabled": false
    },
    {
      "description": [
        "Update the Compose and Kubernetes cloudflared examples together to preserve their exact-image validation contract."
      ],
      "matchManagers": [
        "docker-compose",
        "kubernetes"
      ],
      "matchFileNames": [
        "examples/docker/compose.yaml",
        "examples/k3s/cloudflared.yaml"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cloudflare/cloudflared"
      ],
      "enabled": true,
      "groupName": "Application dependencies",
      "groupSlug": "application-dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "automerge": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      ".github/cosign/**",
      ".github/requirements-ci.in",
      ".github/requirements-ci.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-ci\\.txt$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^examples\\/k3s\\/cloudflared\\.yaml$/"
    ]
  }
}
